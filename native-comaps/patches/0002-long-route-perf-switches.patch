+/// UltimateMaps patch: run-time switches of the long-route (LeapsOnly) pipeline, see docs/phase2/long-routes-perf.md.
+/// The defaults reproduce the stock CoMaps behaviour exactly. Process-wide; set between routes, not during one.
+struct RoutePerfConfig
+{
+  /// Stop collecting leaps candidates when this many distinct first and last transitions were found (stock: 15).
+  uint32_t m_leapsMaxVertices = 15;
+  /// Wall-clock cap on collecting leaps candidates once at least one route exists (stock: 30000 ms).
+  uint32_t m_leapsTimeoutMs = 30000;
+  /// Skip the start/finish sub-route of a candidate when a lower bound already proves it cannot beat the best one.
+  /// Exact for the car profile: the same candidate is chosen as without it.
+  bool m_pruneCandidates = false;
+  /// Keep the car IndexGraph/geometry loader between routes instead of re-reading the routing section every time.
+  bool m_persistGraphs = false;
+};
+void SetRoutePerfConfig(RoutePerfConfig const & config);
+RoutePerfConfig GetRoutePerfConfig();
+
+/// What the last route spent where (only the long-route pipeline fills the stage fields). Written by the routing thread.
+struct RoutePerfStats
+{
+  int m_mode = 0;                    // 1 = Joints, 2 = NoLeaps, 3 = LeapsOnly, 0 = no route yet
+  uint32_t m_leapsMs = 0;            // stage 1: bidirectional search of cross-mwm candidates
+  uint32_t m_leapsRoutes = 0;        // routes the search produced before filtering
+  uint32_t m_candidates = 0;         // candidates left after filtering
+  uint32_t m_candidatesMs = 0;       // stage 2: start/finish sub-routes of every candidate
+  uint32_t m_legsPruned = 0;         // sub-routes skipped by m_pruneCandidates
+  uint32_t m_finalMs = 0;            // stage 3: sub-routes through the middle mwms of the best candidate
+  uint32_t m_subRoutesComputed = 0;  // sub-route A* runs (cache misses of RoutesCalculator)
+  uint32_t m_subRoutesCached = 0;    // sub-route requests answered from the cache
+  bool m_graphsReused = false;       // the persistent graph loader was reused from a previous route
+};
+void ResetRoutePerfStats();
+RoutePerfStats GetRoutePerfStats();
