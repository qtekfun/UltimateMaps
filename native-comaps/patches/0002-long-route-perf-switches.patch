+/// Forwards to a loader that outlives the world graph (WorldGraph owns its loader through a unique_ptr).
+class SharedIndexGraphLoader final : public IndexGraphLoader
+{
+public:
+  explicit SharedIndexGraphLoader(std::shared_ptr<IndexGraphLoader> impl) : m_impl(std::move(impl)) {}
+
+  IndexGraph & GetIndexGraph(NumMwmId mwmId) override { return m_impl->GetIndexGraph(mwmId); }
+  Geometry & GetGeometry(NumMwmId numMwmId) override { return m_impl->GetGeometry(numMwmId); }
+  std::vector<RouteSegment::SpeedCamera> GetSpeedCameraInfo(Segment const & segment) override
+  {
+    return m_impl->GetSpeedCameraInfo(segment);
+  }
+  void Clear() override {}  // the owner decides when the cache goes away
+
+private:
+  std::shared_ptr<IndexGraphLoader> m_impl;
+};
