+// UltimateMaps: true if one of the types is highway|<class>|tunnel (the generator gives a tunnel road one of those).
+bool HasHighwayTunnelType(feature::TypesHolder const & types)
+{
+  auto const & c = classif();
+  for (uint32_t t : types)
+  {
+    if (ftype::GetLevel(t) != 3)
+      continue;
+    auto const * p = c.GetRoot()->GetObject(ftype::GetValue(t, 0));
+    if (p->GetName() != "highway")
+      continue;
+    p = p->GetObject(ftype::GetValue(t, 1))->GetObject(ftype::GetValue(t, 2));
+    if (p->GetName() == "tunnel")
+      return true;
+  }
+  return false;
+}
