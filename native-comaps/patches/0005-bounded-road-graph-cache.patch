+std::vector<NumMwmId> IndexGraphLoaderImpl::Retain(size_t keep)
+{
+  std::vector<std::pair<uint64_t, NumMwmId>> byUse;
+  byUse.reserve(m_graphs.size());
+  for (auto const & [id, attrs] : m_graphs)
+    byUse.emplace_back(attrs.m_lastUse, id);
+  std::sort(byUse.begin(), byUse.end(), [](auto const & l, auto const & r) { return l.first > r.first; });
+
+  std::vector<NumMwmId> kept;
+  for (size_t i = 0; i < byUse.size(); ++i)
+  {
+    if (i < keep)
+      kept.push_back(byUse[i].second);
+    else
+      m_graphs.erase(byUse[i].second);
+  }
+  for (auto it = m_cachedCameras.begin(); it != m_cachedCameras.end();)
+    it = std::find(kept.begin(), kept.end(), it->first) == kept.end() ? m_cachedCameras.erase(it) : std::next(it);
+  return kept;
+}
