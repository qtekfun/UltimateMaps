+bool BicycleModel::IsCycleInfra(FeatureTypes const & types) const
+{
+  for (uint32_t t : types)
+  {
+    ftype::TruncValue(t, 2);
+    if (t == m_cyclewayType || t == m_yesType)
+      return true;
+  }
+  return false;
+}
+
+bool BicycleModel::IsFerry(FeatureTypes const & types) const
+{
+  auto const hw = GetHighwayType(types);
+  return hw && *hw == HighwayType::RouteFerry;
+}
+
 SpeedKMpH BicycleModel::GetSpeed(FeatureTypes const & types, SpeedParams const & speedParams) const
 {
-  return GetTypeSpeedImpl(types, speedParams, false /* isCar */);
+  auto speed = GetTypeSpeedImpl(types, speedParams, false /* isCar */);
+
+  // Only the weight is scaled: the ETA must stay realistic.
+  double const factor = BicycleCycleInfraWeightFactor(GetBicycleCycleInfra());
+  if (factor < 1.0 && !IsCycleInfra(types) && !IsFerry(types))
+    speed.m_weight *= factor;
+  return speed;
+}
+
+bool BicycleModel::IsRoad(FeatureTypes const & types) const
+{
+  if (!VehicleModel::IsRoad(types))
+    return false;
+  if (GetBicycleCycleInfra() != BicycleCycleInfra::Only)
+    return true;
+  return IsCycleInfra(types) || IsFerry(types);
 }
 
