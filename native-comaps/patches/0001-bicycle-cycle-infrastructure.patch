+// UltimateMaps: weight factors for roads that are not cycle infrastructure. Starting values to tune on real routes
+// (not measured). They only lower weights, so the A* heuristic (max model speed) stays admissible.
+double constexpr kPreferNonInfraFactor = 0.8;
+double constexpr kStronglyPreferNonInfraFactor = 0.5;
+
+std::atomic<int> g_cycleInfraLevel{static_cast<int>(routing::BicycleCycleInfra::Off)};
 }  // namespace bicycle_model
 
 namespace routing
 {
+void SetBicycleCycleInfra(BicycleCycleInfra level)
+{
+  bicycle_model::g_cycleInfraLevel.store(static_cast<int>(level), std::memory_order_relaxed);
+}
+
+BicycleCycleInfra GetBicycleCycleInfra()
+{
+  return static_cast<BicycleCycleInfra>(bicycle_model::g_cycleInfraLevel.load(std::memory_order_relaxed));
+}
+
+double BicycleCycleInfraWeightFactor(BicycleCycleInfra level)
+{
+  switch (level)
+  {
+  case BicycleCycleInfra::Prefer: return bicycle_model::kPreferNonInfraFactor;
+  case BicycleCycleInfra::StronglyPrefer: return bicycle_model::kStronglyPreferNonInfraFactor;
+  case BicycleCycleInfra::Off:
+  case BicycleCycleInfra::Only: break;
+  }
+  return 1.0;
+}
+
 BicycleModel::BicycleModel() : BicycleModel(bicycle_model::kDefaultOptions) {}
 
