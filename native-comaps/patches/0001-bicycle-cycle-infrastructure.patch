 namespace routing
 {
+/// UltimateMaps patch: how strongly bicycle routing prefers cycle infrastructure.
+/// Cycle infrastructure = highway=cycleway or hwtag=yesbicycle (cycleway=lane/track, bicycle=yes/designated, ...).
+/// See docs/phase2/bike-cycleways.md.
+enum class BicycleCycleInfra : int
+{
+  Off = 0,             // stock CoMaps behaviour
+  Prefer = 1,          // non-infrastructure roads weigh less
+  StronglyPrefer = 2,  // non-infrastructure roads weigh much less
+  Only = 3             // non-infrastructure roads (except ferries) are not routable
+};
+
+/// Process-wide, read when a road geometry is loaded (once per route). Thread-safe.
+void SetBicycleCycleInfra(BicycleCycleInfra level);
+BicycleCycleInfra GetBicycleCycleInfra();
+
+/// Weight factor (0 < f <= 1) applied to roads that are not cycle infrastructure. 1.0 for Off and Only.
+double BicycleCycleInfraWeightFactor(BicycleCycleInfra level);
 
