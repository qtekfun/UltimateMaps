<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        INTERNET is requested for the region-download flow only (the MapLibre library declares it too, so the
        merged manifest has it either way). Every connection goes through NetworkPolicy; with offline mode on,
        none is attempted. The map itself reads local files and the style references no remote URL.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Turn-by-turn navigation keeps reading the location with the screen off: foreground service of type location. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+: lets the navigation notification be promoted to a Live Update (status bar chip). Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        Package visibility (Android 11+): without this the app cannot see any text-to-speech engine and
        TextToSpeech fails to start even when one is installed. Only the TTS service action is declared.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".MapasApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mapas">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Launcher app shortcuts (search, saved places, maps, emergency) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />

            <!-- RF-11: geo: URIs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>

            <!-- RF-11: Google Maps (long and short), Apple Maps and Waze. Not verified (we do not own the domains):
                 on Android 12+ the user must enable them in "Open by default > Add links". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.google.com" />
                <data android:pathPrefix="/maps" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="maps.google.com" />
                <data android:host="maps.app.goo.gl" />
                <data android:host="maps.apple.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="goo.gl" />
                <data android:pathPrefix="/maps" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="waze.com" />
                <data android:host="www.waze.com" />
                <data android:pathPrefix="/ul" />
            </intent-filter>
        </activity>

        <!-- "Maps" screen: catalog, downloads, storage -->
        <activity
            android:name=".regions.RegionsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings: privacy and petrol stations -->
        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Emergency screen: coordinates on screen, a dial button for 112 (ACTION_DIAL, no call permission) and a share button -->
        <activity
            android:name=".emergency.EmergencyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="false" />

        <!-- Region downloads keep running with the screen off: foreground service of type dataSync (Android 14+) -->
        <service
            android:name=".regions.RegionDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Navigation in the background: a foreground service of type location (Android 14+: needs the permission above). -->
        <service
            android:name=".nav.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
